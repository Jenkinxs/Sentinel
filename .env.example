## Sentinel Environment Configuration
##
## Copy this file to .env and fill in your values.
## .env takes precedence over config.ini when both are present.

## Required: Your API key for the LLM provider
SENTINEL_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"

## Optional overrides (defaults from config.ini are used if omitted)
# SENTINEL_URL="https://openrouter.ai/api/v1"
# SENTINEL_GENERATOR="openai/gpt-oss-120b:free"
# SENTINEL_REVIEWER="openai/gpt-oss-120b:free"
# SENTINEL_STREAM=true
